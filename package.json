{
  "name": "stream-reviver",
  "version": "3.1.6",
  "private": true,
  "description": "A conservative, opt-in live stream monitor for Chrome and Firefox.",
  "author": {
    "name": "Cameron Amer",
    "url": "https://www.cameronamer.com"
  },
  "homepage": "https://www.cameronamer.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caamer20/stream-reviver.git"
  },
  "bugs": {
    "url": "https://github.com/caamer20/stream-reviver/issues"
  },
  "license": "MIT",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": "24.2.0",
    "npm": "11.4.2"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:development": "node scripts/build.mjs --channel development",
    "build:beta": "node scripts/build.mjs --channel beta",
    "build:stable": "node scripts/build.mjs --channel stable",
    "build:source": "node scripts/build.mjs --channel stable --source-archive",
    "build:channels": "npm run build:development && npm run build:beta && npm run build:stable",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "test:e2e": "node scripts/e2e.mjs",
    "test:performance": "node scripts/performance-check.mjs",
    "test:accessibility": "node scripts/accessibility-check.mjs",
    "test:release-integrity": "node scripts/release-integrity.test.mjs && node scripts/deterministic-zip.test.mjs && node scripts/release-artifacts.test.mjs && node scripts/source-archive.test.mjs && node scripts/icon.test.mjs && node scripts/no-egress.test.mjs",
    "test:soak:smoke": "npm run build && node scripts/soak.mjs --smoke",
    "test:soak": "npm run build && node scripts/soak.mjs --hours 24",
    "test:firefox": "npm run build && node scripts/firefox-smoke.mjs",
    "test:firefox:e2e": "npm run build && node scripts/firefox-e2e.mjs",
    "lint:firefox": "npm run build && node scripts/firefox-smoke.mjs --lint-only",
    "check:toolchain": "node scripts/toolchain-check.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies": "npm audit --audit-level=high",
    "release:check": "npm run check:toolchain && npm run audit:dependencies && npm run check && npm run test:coverage && npm run test:performance && npm run test:accessibility && npm run test:release-integrity && npm run build:stable && node scripts/release-check.mjs --channel stable",
    "package": "npm run release:check && node scripts/package.mjs",
    "package:tagged": "npm run release:check && node scripts/package.mjs --require-tag",
    "verify:reproducible": "node scripts/reproducibility-check.mjs",
    "verify:source": "node scripts/verify-source-archive.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "overrides": {
    "web-ext": {
      "addons-linter": "10.13.0"
    }
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "web-ext": "^10.6.0"
  }
}
